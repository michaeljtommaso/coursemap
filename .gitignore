# dependencies / build output
node_modules/
dist/
build/
coverage/

# env & secrets — never commit
.env
.env.*
# .env.development / .env.production carry ONLY public Firebase web config
# (see docs/specs/002-firebase-migration.md §2) — repo moves between machines
!.env.example
!.env.development
!.env.production
*.local
*.pem
*.key
*service-account*.json
serviceAccountKey*.json
*firebase-adminsdk*.json
.sentryclirc

# admin backups — user plan/profile dumps (spec 002 §8d); NEVER commit user data
scripts/backups/
backups/

# parse-prereqs.ts quarantine report (spec 007 §3) — regenerated by every run,
# not source data
scripts/out/

# firebase-tools local deploy cache
.firebase/

# claude / local tooling
.claude/
.playwright-mcp/
.impeccable/
.superpowers/
.worktrees/

# vault extraction artifacts — move into the Obsidian vault, don't commit
vault/
*-vault-raw.md
vault-extract.md

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.suo
*.swp

# Playwright/browser-agent screenshots must never land in the repo root
/*.png
/snap*.md
/*.yml.snapshot
.playwright-mcp/
