                "not": {
                  "number": {
                    "min": 4960,
                    "max": 4999
                  }
                }
              },
              {
                "not": {
                  "subject": [
                    "PE"
                  ]
                }
              },
              {
                "not": {
                  "creditKind": [
                    "ap",
                    "ib",
                    "alevel",
                    "intl",
                    "placement"
                  ]
                }
              },
              {
                "not": {
                  "titleStartsWith": "FWS"
                }
              },
              {
                "anyOf": [
                  {
                    "tag": [
                      "MQL-AG"
                    ]
                  },
                  {
                    "allOf": [
                      {
                        "subject": [
                          "MATH"
                        ]
                      },
                      {
                        "number": {
                          "min": 1100
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "examScore": {
              "exam": [
                "ap-calculus-ab",
                "ap-calculus-bc"
