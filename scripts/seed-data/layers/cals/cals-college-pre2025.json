        "url": "https://catalog.cornell.edu/enrollment-credit-requirements/graduation-requirements/",
        "anchor": "Physical Education and Swim Requirement"
      },
      "note": "Team or marching band credit, and passing the swim test at orientation, in a swim class or by waiver, cannot be read from the schedule, so both are self-confirmed.",
      "kind": "confirm"
    },
    {
      "id": "credits-120",
      "label": "At least 120 academic credits",
      "group": "Credits",
      "source": {
        "url": "https://catalog.cornell.edu/agriculture-life-sciences/",
        "anchor": "CALS Degree Requirements Prior to 2025 (applies to Transfers entering Fall 2026)"
      },
      "note": "PE and 1000-1099 level courses are left out. Repeats and forbidden overlaps are not detected, see the separate check below. Outside credit is capped at 60 and exam credit at 15 (a whole exam course that would pass a cap is left out, so this can read a little short; check with CALS).",
      "kind": "credits",
      "rule": {
        "allOf": [
          {
            "not": {
              "subject": [
                "PE"
              ]
            }
          },
          {
            "not": {
              "number": {
                "min": 1000,
                "max": 1099
              }
            }
          }
        ]
      },
      "requiredCredits": 120,
      "limits": [
        {
          "rule": {
            "creditKind": [
              "ap",
              "ib",
              "alevel",
              "intl",
              "transfer",
              "placement"
            ]
          },
          "label": "At most 60 credits from outside Cornell (exams and transfer courses)",
          "maxCredits": 60
        },
        {
          "rule": {
            "creditKind": [
              "ap",
              "ib",
              "alevel",
              "intl",
              "placement"
            ]
          },
          "label": "At most 15 credits from AP, IB, A-Level, CASE and similar exams",
          "maxCredits": 15
        }
      ]
    },
    {
