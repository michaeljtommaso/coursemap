  "shortName": "EAS",
  "college": "College of Engineering",
  "catalogYear": 2025,
  "totalCredits": 124,
  "affiliationText": "The following courses must be completed or currently enrolled in at the time of affiliation: MATH 1910, MATH 1920, MATH 2930, MATH 2940, PHYS 1112, PHYS 1110, PHYS 2213, CHEM 2090 & CHEM 2091, CHEM 2080 & CHEM 2081 (or CHEM 1570 or PHYS 2214). At least a C- in all courses taken. A GPA of 2.3 or higher. For any course that is repeated, the higher grade will be used. Note: The Engineering Communications Requirement must be met and may be taken as a liberal studies or Advisor-Approved Elective.",
  "electiveGroups": [
    {
