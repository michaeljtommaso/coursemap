{
  "id": "cornell-isst-bs-2025",
  "name": "Information Science, Systems, and Technology, B.S.",
  "shortName": "ISST",
  "college": "College of Engineering",
  "catalogYear": 2025,
  "totalCredits": null,
  "affiliationText": "At least C in two of the following: MATH 2940, ENGRD/CS 2110, and ENGRD 2700 (must have taken at least two of these courses at time of affiliation). GPA >=2.5 between ENGRD/CS 2110, ENGRD 2700, and all completed MATH and ISST Major core courses. Qualifying courses must be taken at Cornell, and for a letter grade. A required supplemental application must be submitted to ISST at affiliations.coecis.cornell.edu/is/ in addition to the College of Engineering's \"Application for Major Affiliation\". For any course that is repeated, the higher grade will be used.",
  "electiveGroups": [
    {
      "id": "liberal-studies",
      "programId": null,
      "name": "Liberal Studies",
      "description": "Six courses and 18 credits from Engineering's seven liberal studies groups.",
      "qualifyingRule": { "type": "category", "category": "liberal-studies" },
      "minCredits": 3,
      "advisorApproval": false,
      "notes": "Six courses, at least 18 credits, from at least 3 of Engineering's 7 groups. Started in Fall 2024 or later: at least 3 credits from Group 7, Race and Equity. At most 2 Communications in Engineering courses count; at least 2 courses must be at the 2000 level or above. A course's class roster category, or Engineering's approved petitions list, decides its group. Chart note: the Engineering Communications Requirement may be met as a liberal studies or Advisor-Approved Elective.",
      "courseIds": []
    },
