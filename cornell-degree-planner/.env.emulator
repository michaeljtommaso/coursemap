# `npm run dev:emu` — Firestore and Auth talk to the local emulators (firebase.json).
# Self-contained on purpose: placeholder web config, so this mode can't reach the
# live project even by accident. The emulators accept any API key; the project id
# must match the one the emulators and scripts/seed-emulator.ts use.
VITE_USE_EMULATORS=true
VITE_FB_API_KEY=<from-firebase-console>
VITE_FB_AUTH_DOMAIN=localhost
VITE_FB_PROJECT_ID=degree-planner-app
VITE_FB_STORAGE_BUCKET=degree-planner-app.appspot.com
VITE_FB_MESSAGING_SENDER_ID=<from-firebase-console>
VITE_FB_APP_ID=<from-firebase-console>
VITE_FB_MEASUREMENT_ID=
