  "rows": [
    {
      "id": "fws",
      "kind": "pool",
      "label": "Two First-Year Writing Seminars",
      "group": "First-Year Writing",
      "source": {
        "url": "https://catalog.cornell.edu/arts-sciences/",
        "anchor": "College of Arts and Sciences Graduation Requirements"
      },
      "note": "A seminar is any course titled 'FWS:' or ENGL 2860 / ENGL 2880. Exclusive: a seminar used here counts toward nothing else. The AP English / IB English route to one seminar needs an exam score the board does not hold, so it is not encoded (confirm with an advisor).",
      "exclusive": true,
      "rule": {
        "anyOf": [
          {
            "titleStartsWith": "FWS:"
          },
          {
            "course": [
              "ENGL-2860",
              "ENGL-2880"
            ]
          }
        ]
      },
      "requiredCourses": 2,
      "requiredCredits": 0
    },
    {
      "id": "distribution",
      "kind": "distribution",
      "label": "All ten distribution categories, from at least 8 courses",
      "group": "Distribution",
      "source": {
        "url": "https://catalog.cornell.edu/arts-sciences/",
        "anchor": "College of Arts and Sciences Graduation Requirements"
      },
      "note": "Eligible courses carry 3+ credits, are not variable credit, and are not AP/IB/transfer/placement credit. A course fills at most 2 categories and at most 2 courses may fill two. External transfers' regular-semester coursework can count per the catalog; the format cannot see that, so all transfer credit is excluded (conservative). A writing seminar never counts here, even one beyond the two the FWS row uses.",
      "rule": {
        "allOf": [
          {
            "minCredits": 3
          },
          {
            "not": {
              "variableCredit": true
            }
          },
          {
            "not": {
              "creditKind": [
                "ap",
                "ib",
                "transfer",
                "placement"
              ]
            }
          },
          {
            "not": {
              "titleStartsWith": "FWS:"
            }
          }
        ]
      },
      "categories": [
