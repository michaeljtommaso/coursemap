  "rows": [
    {
      "id": "physical-life-sciences",
      "kind": "pool",
      "label": "Physical and Life Sciences: 18 credits",
      "group": "Distribution",
      "source": {
        "url": "https://catalog.cornell.edu/agriculture-life-sciences/",
        "anchor": "Distribution Requirements"
      },
      "note": "Counts BIO-AG, CHPH-AG, MQL-AG, OPHLS-AG and the accepted equivalents (PBS-HE, BIO-AS, PHS-AS, SDS-AS), CHEM/PHYS courses 1100+ of 3+ credits, and MATH courses 1100+. FWS never counts. Courses 1000-1099 and 4960-4999 (independent study, TA, research, internship) are excluded. AP calculus/statistics for quantitative literacy needs a score, so AP is not matched. Variable-credit MATH/CHEM/PHYS courses (supervised research and reading) are left out.",
      "rule": {
        "allOf": [
          {
            "not": {
              "number": {
                "min": 1000,
                "max": 1099
              }
            }
          },
          {
            "not": {
              "number": {
                "min": 4960,
                "max": 4999
              }
            }
          },
          {
            "not": {
              "subject": [
                "PE"
              ]
            }
          },
          {
            "not": {
              "creditKind": [
                "ap",
                "ib",
                "placement"
              ]
            }
          },
          {
            "not": {
              "titleStartsWith": "FWS:"
            }
          },
          {
            "anyOf": [
              {
                "tag": [
                  "BIO-AG",
                  "CHPH-AG",
                  "MQL-AG",
                  "OPHLS-AG",
                  "PBS-HE",
                  "BIO-AS",
                  "PHS-AS",
                  "SDS-AS"
                ]
              },
              {
                "allOf": [
                  {
                    "subject": [
                      "CHEM",
                      "PHYS"
                    ]
                  },
                  {
                    "number": {
                      "min": 1100
                    }
                  },
                  {
                    "minCredits": 3
                  },
                  {
                    "not": {
                      "variableCredit": true
                    }
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "subject": [
                      "MATH"
                    ]
                  },
                  {
                    "number": {
                      "min": 1100
                    }
                  },
                  {
                    "not": {
                      "variableCredit": true
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "requiredCourses": 0,
      "requiredCredits": 18,
      "limits": [
        {
          "label": "At least 6 credits of introductory life sciences/biology (BIO-AG)",
          "rule": {
            "tag": [
              "BIO-AG"
            ]
          },
          "minCredits": 6
        },
        {
          "label": "At least 3 credits of chemistry or physics",
          "rule": {
            "anyOf": [
              {
                "tag": [
                  "CHPH-AG"
                ]
              },
              {
                "allOf": [
                  {
                    "subject": [
                      "CHEM",
                      "PHYS"
                    ]
                  },
                  {
                    "number": {
                      "min": 1100
                    }
                  },
                  {
                    "minCredits": 3
                  },
                  {
                    "not": {
                      "variableCredit": true
                    }
                  }
                ]
              }
            ]
          },
          "minCredits": 3
        },
        {
          "label": "At least one quantitative literacy course",
          "rule": {
            "anyOf": [
              {
                "tag": [
                  "MQL-AG"
                ]
              },
              {
                "allOf": [
                  {
                    "subject": [
                      "MATH"
                    ]
                  },
                  {
                    "number": {
                      "min": 1100
                    }
                  },
                  {
                    "not": {
                      "variableCredit": true
                    }
                  }
                ]
              }
            ]
          },
          "minCourses": 1
        }
      ]
    },
