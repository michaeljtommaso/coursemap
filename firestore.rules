rules_version = '2';

// Cornell Degree Planner — Firestore security rules (docs/specs/002 §8a).
// Fail-closed: public-read catalog, users/plans self-only with exact-shape
// allowlists + size caps, explicit default-deny catch-all.
//
// VALIDATE TWICE: every size/shape cap below mirrors a cap in
// cornell-degree-planner/src/lib/schemas.ts. Keep the two numerically identical;
// the schema file carries the reciprocal "keep in sync with firestore.rules"
// comments. With no Cloud Functions, THESE RULES ARE the server-side boundary —
// client Zod is UX only.
//
// TRIPWIRE (self-escalation): users/{uid} has NO privilege-granting field today
// (no role/admin/beta flag). The moment one appears, it must move behind the
// house-standard self-escalation pattern — diff-denylist on self-writes +
// server-side-only profile creation. Do not add such a field to the allowlist
// below without that guard.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public-read catalog (Admin SDK is the only writer — no client write path) ──
    match /courses/{id}       { allow read: if true; }        // write: Admin SDK only
    match /catalog/{id}       { allow read: if true; }        // write: Admin SDK only
    match /catalogIndex/{id}  { allow read: if true; }        // write: Admin SDK only
    match /programs/{id}      { allow read: if true; }        // write: Admin SDK only

    // ── users/{uid}: self-owned profile ──
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['createdAt','displayName','authProvider','prefs',
              'activePlanId','importedLocalPlan','favoriteCourseIds',
              'creditProfile','lastShareAt'])
        && (!('displayName' in request.resource.data)
            || request.resource.data.displayName == null
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 80))   // schemas.ts UserProfileSchema
        // Favorited courses (spec 006 §E4) — optional + additive; a list capped
        // at 200. `is list` first so a wrong-type value fails on the type check
        // rather than throwing on a missing .size().
        && (!('favoriteCourseIds' in request.resource.data)
            || (request.resource.data.favoriteCourseIds is list
                && request.resource.data.favoriteCourseIds.size() <= 200))  // schemas.ts UserProfileSchema.favoriteCourseIds
        // Credit profile (spec 007 §2) — AP/IB/transfer/placement entries;
        // optional + additive, same house pattern as favoriteCourseIds above.
        // Per-entry shape (satisfiesCourseIds <= 8, etc.) is UX-only client Zod
        // (schemas.ts CreditEntrySchema) — the cap here is the server boundary.
        && (!('creditProfile' in request.resource.data)
            || (request.resource.data.creditProfile is list
                && request.resource.data.creditProfile.size() <= 60))  // schemas.ts UserProfileSchema.creditProfile
        // lastShareAt is a rate-limit stamp: when TOUCHED it must be the server
        // time of this very request (can't be forged forward or backward).
        && (!request.resource.data.diff(resource == null ? {} : resource.data)
              .affectedKeys().hasAny(['lastShareAt'])
            || request.resource.data.lastShareAt == request.time);

      // ── users/{uid}/plans/{planId}: the cloud plan doc ──
      match /plans/{planId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(
               ['name','programId','slotSelections','completedSlotIds',
                'waivedSlotIds','inProgressSlotIds','courseSnapshots',
                'slotOverrides','customSlots','schemaVersion','createdAt',
                'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80                    // schemas.ts PlanSchema.name
          && request.resource.data.slotSelections.size() <= 120         // schemas.ts PlanSchema.slotSelections
          && request.resource.data.courseSnapshots.size() <= 150        // schemas.ts PlanSchema.courseSnapshots
          && request.resource.data.completedSlotIds.size() <= 150       // schemas.ts PlanSchema.completedSlotIds
          && request.resource.data.waivedSlotIds.size() <= 150          // schemas.ts PlanSchema.waivedSlotIds
          // v2 mutability fields (spec 005 §9) — optional for older writers
          && (!('slotOverrides' in request.resource.data)
              || request.resource.data.slotOverrides.size() <= 80)      // schemas.ts PlanSchema.slotOverrides
          && (!('customSlots' in request.resource.data)
              || request.resource.data.customSlots.size() <= 40)        // schemas.ts PlanSchema.customSlots
          // "in progress" state (spec 006 §B.1/§B.5) — purely additive, no
          // schemaVersion bump; optional so pre-existing plan docs pass through.
          && (!('inProgressSlotIds' in request.resource.data)
              || request.resource.data.inProgressSlotIds.size() <= 150); // schemas.ts PlanSchema.inProgressSlotIds
      }
    }

    // ── shares (spec 005 §5): frozen read-only plan snapshots ──
    // Author-verified create; IMMUTABLE after (no update/delete rule at all —
    // house-standard audit-trail pattern; a re-share is a new doc). Public read is the
    // point: the id is an unguessable uuid capability.
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid       // can't forge author
        && request.resource.data.createdAt == request.time           // can't forge timestamps
        // ── RATE LIMIT (cost control, spec 002 §8c): max 1 share / 30s / user.
        // The create must arrive in an atomic batch that stamps
        // users/{uid}.lastShareAt = request.time (getAfter sees the post-batch
        // doc), and the PREVIOUS stamp must be ≥30s old or absent. Enforced
        // server-side — no Cloud Functions needed. Client: services/shares.ts.
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.lastShareAt == request.time
        && (
             !('lastShareAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
             || get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.lastShareAt <= request.time - duration.value(30, 's')
           )
        && request.resource.data.keys().hasOnly(
             ['createdBy','createdAt','planName','programId','programName',
              'enteringYear','slotSelections','completedSlotIds','waivedSlotIds',
              'inProgressSlotIds','courseSnapshots','slotOverrides','customSlots',
              'schemaVersion'])
        && request.resource.data.planName is string
        && request.resource.data.planName.size() <= 80                // schemas.ts ShareSchema
        && request.resource.data.slotSelections.size() <= 120
        && request.resource.data.courseSnapshots.size() <= 150
        && request.resource.data.completedSlotIds.size() <= 150
        && request.resource.data.waivedSlotIds.size() <= 150
        && request.resource.data.slotOverrides.size() <= 80
        && request.resource.data.customSlots.size() <= 40
        // "in progress" state (spec 006 §B.1/§B.5) — optional: new share
        // snapshots may include it, but the field predates no writer yet, so
        // treat absence the same as the v2 mutability fields above.
        && (!('inProgressSlotIds' in request.resource.data)
            || request.resource.data.inProgressSlotIds.size() <= 150); // schemas.ts ShareSchema.inProgressSlotIds
    }

    // ── Explicit default deny (fail-closed) ──
    match /{document=**} { allow read, write: if false; }
  }
}
